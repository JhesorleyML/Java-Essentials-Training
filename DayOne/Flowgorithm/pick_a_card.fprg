<?xml version="1.0"?>
<flowgorithm fileversion="4.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="jheso"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-17 05:58:03 pm"/>
        <attribute name="created" value="amhlc287SkhFU09STEVZTUw7MjAyNi0wOC0xNzsxMToyNzoxNyBhbTsyNzIx"/>
        <attribute name="edited" value="amhlc287SkhFU09STEVZTUw7MjAyNi0wOC0xNzswNTo1ODowMyBwbTsxOzI4NDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="counter, sumSquares, card, squareCard" type="Integer" array="False" size=""/>
            <declare name="average" type="Real" array="False" size=""/>
            <assign variable="counter" expression="1"/>
            <assign variable="sumSquares" expression="0"/>
            <input variable="card"/>
            <while expression="card != 0">
                <assign variable="squareCard" expression="card * card"/>
                <assign variable="sumSquares" expression="sumSquares + squareCard"/>
                <assign variable="counter" expression="counter + 1"/>
                <input variable="card"/>
            </while>
            <assign variable="average" expression="sumSquares / counter"/>
            <output expression="&quot;Average: &quot; &amp;average" newline="True"/>
        </body>
    </function>
</flowgorithm>
